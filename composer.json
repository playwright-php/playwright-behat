{
    "name": "playwright-php/playwright-behat",
    "description": "Behat extension powered by Playwright PHP (Chromium/Firefox/WebKit).",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "behat",
        "behat-extension",
        "browser",
        "e2e",
        "playwright-php",
        "playwright"
    ],
    "authors": [
        {
            "name": "Simon André",
            "email": "smn.andre@gmail.com",
            "homepage": "https://github.com/smnandre"
        },
        {
            "name": "Playwright PHP Contributors",
            "homepage": "https://github.com/playwright-php"
        }
    ],
    "homepage": "https://playwright-php.dev/behat",
    "require": {
        "php": "^8.2",
        "behat/behat": "^3.23",
        "playwright-php/playwright": "^1.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.40",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Playwright\\Behat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Playwright\\Behat\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "thanks": {
            "name": "playwright-php/playwright",
            "url": "https://github.com/playwright-php/playwright"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix --diff",
        "sa": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/phpunit"
    }
}
